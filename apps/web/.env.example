# Public canonical URL. Set to your actual origin before a production build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings → API). Publishable key only; never the secret/service key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Privy app id (dashboard.privy.io). Enables external + embedded wallet sign-in.
NEXT_PUBLIC_PRIVY_APP_ID=

# Server only (tRPC on Vercel). Supabase transaction pooler URL, port 6543.
DATABASE_URL=
